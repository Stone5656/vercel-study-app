{
  "name": "vercel-study-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc --project tsconfig.build.json",
    "start": "node dist/server.js",
    "lint": "eslint src tests playwright.config.ts",
    "lint:fix": "eslint src tests playwright.config.ts --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "tsx --test tests/server/**/*.test.ts",
    "test:e2e": "playwright test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Stone5656/vercel-study-app.git"
  },
  "keywords": [],
  "bugs": {
    "url": "https://github.com/Stone5656/vercel-study-app/issues"
  },
  "homepage": "https://github.com/Stone5656/vercel-study-app#readme",
  "dependencies": {
    "dotenv": "^18.0.10",
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@types/supertest": "7.2.1",
    "eslint": "^10.11.0",
    "lefthook": "^2.1.14",
    "prettier": "3.9.9",
    "supertest": "7.3.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0"
  }
}
